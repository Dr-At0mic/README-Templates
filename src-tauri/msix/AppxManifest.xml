<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package manifest. scripts/build-msix.mjs fills in the version from package.json.
  Identity and PublisherDisplayName come from Partner Center (Product identity) and must match it
  exactly, including case.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="DrAtomic.READMETemplates"
    Publisher="CN=59C61989-EB11-480C-9DAE-138946F0898B"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>README Templates</DisplayName>
    <PublisherDisplayName>Dr Atomic</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="readme-templates.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="README Templates"
        Description="Design and publish a GitHub profile README"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for a desktop app in an MSIX. Partner Center asks for a reason when you submit. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
